rules_version = '2';

// Firebase Storage security rules for the RIED website.
// Two upload areas, both scoped strictly to the signed-in owner:
//   - profile-logos/{uid}/...   company/organisation logo from onboarding
//   - user-uploads/{uid}/...    documents a founder uploads from their dashboard
service firebase.storage {
  match /b/{bucket}/o {

    match /profile-logos/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /user-uploads/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 20 * 1024 * 1024;
    }

    // Marketplace listing photos — PUBLICLY readable (shoppers browsing the
    // marketplace don't need to be signed in to see product photos), but only
    // the seller who owns that folder (their own uid) can upload into it.
    match /marketplace-listings/{sellerId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == sellerId
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Internship Program documents (Phase 1, 2026-07-31) — photo, Aadhar
    // card, and latest marksheet, uploaded from intern-onboarding.html.
    // PRIVATE, unlike marketplace photos: owner-only read/write, no public
    // access at all, since Aadhar cards and marksheets are sensitive
    // personal documents. Accepts images or PDFs (scanned documents are
    // often submitted as either), capped at 10MB per file.
    match /intern-documents/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') ||
                       request.resource.contentType == 'application/pdf');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can read and create their own profile document, and update it
    // EXCEPT for the "role" field (so a member can never self-promote to admin —
    // only done manually by RIED staff directly in the Firebase console for now).
    //
    // SECURITY FIX (2026-07-31): "create" used to only check the uid matched —
    // it never restricted what value "role" could be set to on that very first
    // write, so anyone could sign up and set role:"admin" on themselves in the
    // same setDoc call register.html makes (the client-side ADMIN_EMAILS check
    // in register.html is cosmetic only; Firestore rules are the only real
    // enforcement). Fixed by mirroring that same ADMIN_EMAILS allow-list here,
    // keyed off the verified Firebase Auth token email (which a client cannot
    // forge), so "admin" can only ever be set on account creation for RIED's
    // own two accounts — everyone else is forced to "member".
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId &&
        (
          (request.resource.data.role == 'admin' &&
            request.auth.token.email in ['pramod@ried.co.in', 'neel@ried.co.in']) ||
          (request.resource.data.role == 'member' &&
            !(request.auth.token.email in ['pramod@ried.co.in', 'neel@ried.co.in']))
        );
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;
    }

    // Blog / video posts (Pramod & Neel only) — public can read, only an
    // account whose /users/{uid} doc has role == "admin" can write.
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Founder onboarding profile (Basic Info / Company Info / Individual Founder
    // Discovery answers, plus Flywheel stage progress) — each user can read/write
    // their own doc. An admin (role == "admin" on their own /users doc) can also
    // read across all profiles (to list pending stage-advancement requests) and
    // update any profile (to approve an advancement, per the "RIED approves
    // advancement" flow) — but can never self-serve a stage advancement for
    // themselves via a non-admin path, since createUpdate below is still the
    // only other write path and it's uid-scoped.
    // A Cloud Function (onCreate/onWrite trigger) reads this server-side to email
    // a copy to hello@ried.co.in — that server-side read uses the Admin SDK and
    // is not subject to these rules.
    match /profiles/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"));
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"));
    }

    // Founder Flywheel dashboard file uploads (metadata only — the actual file
    // bytes live in Cloud Storage; see storage.rules). Each user can only
    // read/create/delete their own upload records.
    match /uploads/{userId}/files/{fileId} {
      allow read, create, delete: if request.auth != null && request.auth.uid == userId;
      allow update: if false;
    }

    // ===========================================================================
    // MARKETPLACE (Phase 1: listings only — cart/orders rules included now so we
    // don't need a second Console publish round later, but those features aren't
    // built yet).
    // ===========================================================================

    // Marketplace listings — any onboarded founder (i.e. someone with a
    // /profiles/{uid} doc) can create/edit/delete their OWN listings. Public
    // (including signed-out visitors) can read a listing only while it's
    // marked active; the owning seller can always read their own, active or not,
    // so they can see their own paused/draft listings on their dashboard.
    // sellerId is immutable after creation, same pattern as "role" on /users.
    match /listings/{listingId} {
      allow read: if resource.data.active == true ||
        (request.auth != null && request.auth.uid == resource.data.sellerId);
      allow create: if request.auth != null &&
        request.resource.data.sellerId == request.auth.uid &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
      allow update: if request.auth != null && request.auth.uid == resource.data.sellerId &&
        request.resource.data.sellerId == resource.data.sellerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.sellerId;
    }

    // Shopping cart — one document per signed-in user, fully owner-only.
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders — both the Packages checkout (createRazorpayOrder /
    // verifyRazorpayPayment in functions/index.js) and any future Marketplace
    // checkout write here, ONLY server-side via the Admin SDK (which bypasses
    // these rules entirely), never directly by a client, so a buyer can never
    // fake a "paid" order. The buyer who placed an order (the doc's "uid"
    // field, set by createRazorpayOrder) can read it back; an admin can read
    // all orders (needed to track and reconcile manual seller payouts, since
    // RIED collects payments centrally rather than splitting them automatically).
    // A seller can also read an order if their uid appears in that order's
    // sellerIds array (Tier 20 — needed for the My Sales view on
    // my-listings.html) — the 'sellerIds' in resource.data guard means this
    // never errors out on older orders (Packages orders, or any Marketplace
    // order from before this field existed) that don't have the field at all.
    match /orders/{orderId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.uid ||
        (('sellerIds' in resource.data) && request.auth.uid in resource.data.sellerIds) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"));
      allow create, update, delete: if false;
    }

    // ===========================================================================
    // INTERNSHIP PROGRAM (Phase 1, 2026-07-31 — sign-up + onboarding.
    // Phase 2, 2026-08-03 — skills assessment). The "status" field is
    // deliberately future-proofed for phases not built yet:
    // 'signed_up' -> 'onboarded' -> 'assessment_completed' -> (Phase 4)
    // 'approved' | 'rejected'. Note: the client NEVER writes
    // 'assessment_completed' directly — only submitAssessment
    // (functions/index.js) does, via the Admin SDK, which bypasses these
    // rules entirely. The "update" rule below only needs to cover the one
    // self-serve transition a candidate's own browser ever performs
    // ('signed_up' -> 'onboarded' during onboarding); everything past that
    // is Cloud-Function-only.
    // ===========================================================================

    // A candidate can read/write only their own application. Same
    // self-escalation protection as the v15 /users fix above: "create" only
    // allows the safe starting status, and "update" only lets the candidate
    // themselves move from 'signed_up' to 'onboarded' — every later status
    // (assessment_completed/approved/rejected) can only ever be set by an
    // admin or a Cloud Function via the Admin SDK. An admin (role == "admin"
    // on their own /users doc) can read every application, needed for the
    // future approval dashboard.
    match /interns/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"));
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.status == 'signed_up';
      allow update: if request.auth != null && (
        (request.auth.uid == userId &&
          (request.resource.data.status == resource.data.status ||
            (resource.data.status == 'signed_up' && request.resource.data.status == 'onboarded'))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    // Skills assessment sessions (Phase 2) — the private, per-candidate
    // question selection + option-shuffle mapping + timer deadline that
    // startAssessment/submitAssessment (functions/index.js) read and write.
    // Deliberately NO client access at all, in either direction: this falls
    // through to the "everything else is closed" catch-all below and relies
    // on that, exactly like /orders relies on "create, update, delete: if
    // false" — the Cloud Functions above use the Admin SDK, which bypasses
    // Firestore rules entirely, so no explicit allow is ever needed here.
    // (No match block needed for /assessmentSessions/{userId} — leaving it
    // unmatched is the point.)

    // ===========================================================================
    // INTERNSHIP PROGRAM — PHASE 3 (2026-08-03): Attendance + Daily Tasks +
    // Request Center. Portal access itself is gated client-side/in Cloud
    // Functions on /interns/{uid}.status == "approved" (Phase 4 is what will
    // actually set that status — until then RIED can flip a test account by
    // hand in the Console). /internTasks and /internRequests rules are
    // written now, ahead of Phase 4's admin UI, same convention as
    // /carts+/orders being pre-built ahead of Marketplace's checkout UI back
    // in Tier 9 — avoids a second Console-publish round once Phase 4 ships.
    // ===========================================================================

    // Attendance — doc id is "{uid}_{date}", one per intern per day.
    // Cloud-Function-only writes (clockIn/startBreak/endBreak/clockOut in
    // functions/index.js, via the Admin SDK, which bypasses these rules
    // entirely) — exactly the same "allow create/update: if false" pattern
    // /orders uses, so a client can never fake or edit their own clocked
    // times. The owning intern can read their own record; an admin can read
    // every intern's, needed for the future attendance-report/anomaly view.
    match /attendance/{attendanceId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"));
      allow create, update, delete: if false;
    }

    // Daily Tasks — created by a Mentor (Phase 4, not built yet — this rule
    // is pre-built for it) and read/self-updated by the intern they're
    // assigned to. An intern can only flip status forward along the two
    // safe steps they're allowed to do themselves ('assigned' ->
    // 'acknowledged', then 'acknowledged' -> 'completed') — anything else
    // (assigning, commenting, reopening, reassigning) needs an admin, same
    // self-escalation-safe shape as /interns' status field above.
    match /internTasks/{taskId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.internUid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"));
      allow create: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.internUid &&
          ((resource.data.status == 'assigned' && request.resource.data.status == 'acknowledged') ||
           (resource.data.status == 'acknowledged' && request.resource.data.status == 'completed'))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
      allow delete: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Request Center — Edit Profile / Appointment Letter / Leave Request /
    // Experience Letter / Resignation, all one collection discriminated by
    // "type" (matches the original ask that every one of these "has to come
    // to hello@ried.co.in" — notifyOnInternRequest in functions/index.js
    // handles that). An intern can only ever create their OWN request,
    // starting at status 'pending' (same starting-value guard as /interns'
    // create rule) — only an admin can move it to approved/rejected
    // (Phase 4). No client update path for the intern at all once
    // submitted, by design — matches "requests," not editable drafts.
    match /internRequests/{requestId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.internUid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"));
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.internUid &&
        request.resource.data.status == 'pending';
      allow update: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
      allow delete: if false;
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
